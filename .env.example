# Frontend (Vite)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=replace-with-anon-key
VITE_API_URL=http://localhost:8000/api/v1

# FastAPI / Supabase
# A transaction pooler URL (port 6543) is recommended for serverless/Railway
# deployments. Add ?sslmode=require when the provider requires it.
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace-with-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
SUPABASE_JWT_SECRET=replace-with-jwt-secret
# Alternatively use the asymmetric project JWKS URL:
# SUPABASE_JWT_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_AUDIENCE=authenticated
CORS_ORIGINS=http://localhost:5173
SUPABASE_EVIDENCE_BUCKET=evidence
SUPABASE_GENERATED_BUCKET=generated

# Publication providers
ORCID_API_URL=https://pub.orcid.org/v3.0
OPENALEX_API_URL=https://api.openalex.org
CROSSREF_API_URL=https://api.crossref.org
OPENALEX_MAILTO=your-email@example.com
CROSSREF_MAILTO=your-email@example.com

# Idempotent seed configuration (never commit actual values)
SEED_FACULTY_EMAIL=ananya.sharma@example.edu
SEED_FACULTY_PASSWORD=replace-with-a-local-seed-password
SEED_ADMIN_EMAIL=meera.kulkarni@example.edu
SEED_ADMIN_PASSWORD=replace-with-a-local-seed-password
