# Frontend (Vite)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=replace-with-anon-key
VITE_API_URL=http://localhost:8000/api/v1

# FastAPI / Supabase
# A transaction pooler URL (port 6543) is recommended for serverless/Railway
# deployments. Add ?sslmode=require when the provider requires it.
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace-with-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
SUPABASE_JWT_SECRET=replace-with-jwt-secret
# Alternatively use the asymmetric project JWKS URL:
# SUPABASE_JWT_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_AUDIENCE=authenticated
CORS_ORIGINS=http://localhost:5173
SUPABASE_EVIDENCE_BUCKET=evidence
SUPABASE_GENERATED_BUCKET=generated
# Applies to every route, authenticated or not (slowapi, keyed by client IP).
RATE_LIMIT_DEFAULT=120/minute

# Publication providers
ORCID_API_URL=https://pub.orcid.org/v3.0
OPENALEX_API_URL=https://api.openalex.org
CROSSREF_API_URL=https://api.crossref.org
OPENALEX_MAILTO=your-email@example.com
CROSSREF_MAILTO=your-email@example.com

# Idempotent seed configuration (never commit actual values)
SEED_FACULTY_EMAIL=ananya.sharma@example.edu
SEED_FACULTY_PASSWORD=replace-with-a-local-seed-password
SEED_ADMIN_EMAIL=meera.kulkarni@example.edu
SEED_ADMIN_PASSWORD=replace-with-a-local-seed-password

# Optional: structured-extraction LLM for CV Import, Teaching Change
# interpretation, LOR letter polish, and Quick Add parsing. Every one of
# those features has a deterministic fallback and works with this unset.
# Get a free key at https://console.groq.com/keys (no billing card required
# to start). Groq is used specifically for its inference speed -- these are
# calls a professor is waiting on in real time, not background batch jobs.
GROQ_API_KEY=replace-with-groq-api-key
LLM_MODEL=openai/gpt-oss-20b
# Vision-capable model, used only for OCR of scanned/photographed uploads
# (CV Import images, image-only PDF pages). Same GROQ_API_KEY above.
LLM_VISION_MODEL=qwen/qwen3.6-27b

# Optional: route LLM calls through OpenRouter instead of Groq. Both speak the
# same OpenAI chat-completions dialect, so this only swaps endpoint, key and
# model -- no feature behaves differently. Leave as "groq" unless you need a
# model Groq does not host.
#
# NOTE: the selected provider must have its own key. Setting
# LLM_PROVIDER=openrouter while only GROQ_API_KEY is set counts as
# unconfigured, and every feature falls back to its deterministic path rather
# than silently calling the other provider with a model it does not have.
LLM_PROVIDER=groq
OPENROUTER_API_KEY=replace-with-openrouter-api-key
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
OPENROUTER_VISION_MODEL=anthropic/claude-sonnet-4.5
# Optional, for attribution on the OpenRouter dashboard only.
OPENROUTER_APP_URL=
OPENROUTER_APP_TITLE=Sanchaya

# Optional: run the Assistant's agent loop on a different model from the 23
# extraction services, whose prompts are tuned for a fast cheap model. Tool
# routing is the one place a stronger model measurably pays off. Applies to
# whichever provider LLM_PROVIDER selects; unset means "use that provider's
# default model above".
AGENT_MODEL=

# Optional: Google OAuth for Reconstruct My Year (Gmail/Calendar/Drive,
# read-only scopes). Get these from https://console.cloud.google.com ->
# APIs & Services -> Credentials -> OAuth client ID (Web application). The
# redirect URI below MUST be added to that client's "Authorized redirect
# URIs" list exactly as written -- it points at the FastAPI backend's own
# callback route (not a frontend page), so change the host:port only if the
# backend runs somewhere other than localhost:8000.
# Leave unset to keep the connectors in a clean "Not configured" state; set
# RECONSTRUCT_FAKE_SOURCES=true to exercise the full reconstruction pipeline
# against fixture data instead of live Google.
GOOGLE_OAUTH_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_OAUTH_CLIENT_SECRET=replace-with-google-oauth-client-secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/reconstruct/oauth/callback
RECONSTRUCT_FAKE_SOURCES=false

